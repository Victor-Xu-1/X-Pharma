{
  "name": "x-pharma-workspace",
  "license": "Apache-2.0",
  "private": true,
  "version": "0.1.29",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "api:generate": "node scripts/openapi-contract.mjs --write",
    "api:check": "node scripts/openapi-contract.mjs --check",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/verify-workbench-build.mjs",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.e2e.json --pretty false"
  },
  "dependencies": {
    "@rdkit/rdkit": "2026.3.6",
    "@tanstack/react-query": "5.101.2",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.6",
    "echarts": "6.1.0",
    "ketcher-core": "3.17.1",
    "ketcher-react": "3.17.1",
    "ketcher-standalone": "3.17.1",
    "lucide-react": "1.24.0",
    "paper": "0.12.18",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "web-vitals": "6.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "@types/node": "26.6.3",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "29.1.1",
    "openapi-typescript-codegen": "0.31.0",
    "typescript": "7.0.2",
    "vite": "8.1.4",
    "vitest": "4.1.11"
  }
}
