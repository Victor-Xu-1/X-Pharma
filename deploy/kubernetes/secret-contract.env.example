# Store these application keys at OpenBao KV v2 path
# `pharma-kv/production/application`. ESO adds DATABASE_URL from the
# `database/creds/pharma-runtime` dynamic lease. Never apply this file as a Secret.
JWT_SECRET=replace-with-64-random-characters
INTERNAL_SERVICE_JWT_SECRET=replace-with-independent-64-random-characters
TENANT_CONTEXT_SIGNING_SECRET=replace-with-third-independent-64-random-characters
MCP_CURSOR_SIGNING_SECRET=replace-with-fourth-independent-64-random-characters
MCP_CORRELATION_HMAC_SECRET=replace-with-fifth-independent-64-random-characters
REDIS_URL=rediss://:replace-with-valkey-password@valkey.example.com:6379/0
BILLING_STATEMENT_SIGNING_SECRET=replace-with-sixth-independent-64-random-characters
EXPORT_MANIFEST_SIGNING_SECRET=replace-with-seventh-independent-64-random-characters
API_KEY_HASH_SALT=replace-with-32-random-characters
HUMAN_OIDC_CLIENT_SECRET=replace
OBJECT_STORE_S3_ACCESS_KEY_ID=replace
OBJECT_STORE_S3_SECRET_ACCESS_KEY=replace
AI_API_KEY=replace

# Store only these independent service credentials at
# `pharma-kv/production/document-processing`. ESO mounts the resulting Secret
# only into the unified jobs process and the two isolated parser/OCR services.
parser_service_token=replace-with-eighth-independent-64-random-characters
ocr_service_token=replace-with-ninth-independent-64-random-characters

# Store two independent credential pairs at `pharma-kv/production/opensearch/query`
# and `pharma-kv/production/opensearch/jobs`.
# All paths use these key names.
# The query role is read-only and only mounted into API Pods. The jobs role may
# write live projections, create rebuild indices, and atomically swap aliases.
# Never store either pair in `production/application`.
OPENSEARCH_USERNAME=replace-with-role-specific-username
OPENSEARCH_PASSWORD=replace-with-role-specific-password

# Store only this key at `pharma-kv/production/embedding`; ESO mounts the
# resulting Secret into API and unified jobs Pods.
SEARCH_EMBEDDING_API_KEY=replace-with-approved-embedding-provider-credential

# Store only this key at `pharma-kv/production/billing-provider`. ESO mounts it
# into unified jobs Pods alongside the platform Secret. It is not mounted into
# the gateway or isolated parser/OCR Pods.
BILLING_PROVIDER_API_TOKEN=replace-with-provider-scoped-credential-at-least-32-bytes

# cert-manager or the enterprise PKI must create separate Kubernetes Secrets:
# pharma-parser-server-tls: serverAuth tls.crt/tls.key plus ca.crt
# pharma-parser-client-tls: clientAuth tls.crt/tls.key plus ca.crt

# Store only this key at `pharma-kv/production/migration`; it is consumed by
# the migration Job and is never mounted into gateway, jobs, parser, or OCR Pods.
MIGRATION_DATABASE_URL=postgresql+psycopg://migration-user:replace@postgres.example.com:5432/pharma
