{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/pharma/external-workbench-capability-matrix.v1.schema.json",
  "title": "External research workbench capability matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "goal_document_id", "goal_version", "reviewed_at", "completion_rule", "experience_gate", "domains"],
  "properties": {
    "schema": {"const": "pharma.external-workbench-capability-matrix.v1"},
    "schema_version": {"const": 1},
    "goal_document_id": {"const": "PIP-GOAL-001"},
    "goal_version": {"const": "1.10.1"},
    "reviewed_at": {"type": "string", "format": "date"},
    "completion_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_domain_count", "required_priorities", "required_status", "requires_real_data", "requires_business_uat", "requires_experience_gate"],
      "properties": {
        "required_domain_count": {"const": 12},
        "required_priorities": {"const": ["P0", "P1"]},
        "required_status": {"const": "implemented"},
        "requires_real_data": {"const": true},
        "requires_business_uat": {"const": true},
        "requires_experience_gate": {"const": true}
      }
    },
    "experience_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_status", "criteria"],
      "properties": {
        "required_status": {"const": "implemented"},
        "criteria": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status", "evidence"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,95}$"},
              "status": {"enum": ["implemented", "partial", "not_started"]},
              "remaining_gaps": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 3, "maxLength": 400}
              },
              "evidence": {
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 3, "maxLength": 240}
              }
            },
            "allOf": [
              {
                "if": {"properties": {"status": {"enum": ["partial", "not_started"]}}},
                "then": {"required": ["remaining_gaps"]},
                "else": {"not": {"required": ["remaining_gaps"]}}
              }
            ]
          }
        }
      }
    },
    "domains": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "status", "capabilities"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
          "title": {"type": "string", "minLength": 2, "maxLength": 80},
          "status": {"enum": ["implemented", "partial", "not_started"]},
          "remaining_gaps": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 3, "maxLength": 400}
          },
          "capabilities": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "priority", "status", "evidence"],
              "properties": {
                "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,95}$"},
                "priority": {"enum": ["P0", "P1"]},
                "status": {"enum": ["implemented", "partial", "not_started"]},
                "evidence": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {"type": "string", "minLength": 3, "maxLength": 240}
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"enum": ["partial", "not_started"]}}},
            "then": {"required": ["remaining_gaps"]},
            "else": {"not": {"required": ["remaining_gaps"]}}
          }
        ]
      }
    }
  }
}
