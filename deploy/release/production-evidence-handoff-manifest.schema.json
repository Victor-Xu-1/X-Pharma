{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pharma-intelligence.invalid/schemas/production-evidence-handoff.v2.json",
  "title": "Production evidence requirements handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "generated_at",
    "status",
    "production_claim",
    "subject",
    "policy_sha256",
    "categories",
    "files",
    "signature"
  ],
  "properties": {
    "schema": {"const": "pharma.production-evidence-handoff.v2"},
    "schema_version": {"const": 2},
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {"const": "requirements_only"},
    "production_claim": {"const": false},
    "subject": {
      "type": "object",
      "required": ["git_commit", "source_file_count", "source_tree_sha256"]
    },
    "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "requirements"],
        "properties": {
          "category": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
          "requirements": {"type": "string", "pattern": "^requirements/[a-z][a-z0-9_]{1,63}\\.json$"}
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "size": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present", "key_id", "public_key_sha256"],
      "properties": {
        "present": {"type": "boolean"},
        "key_id": {"type": ["string", "null"], "minLength": 3, "maxLength": 128},
        "public_key_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
