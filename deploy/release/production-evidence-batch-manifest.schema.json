{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pharma-intelligence.invalid/schemas/production-evidence-batch.v1.json",
  "title": "Registered production evidence batch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "generated_at",
    "status",
    "production_claim",
    "subject",
    "security_manifest_sha256",
    "categories"
  ],
  "properties": {
    "schema": {"const": "pharma.production-evidence-batch.v1"},
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {"const": "registered"},
    "production_claim": {"const": false},
    "subject": {
      "type": "object",
      "required": ["git_commit", "source_file_count", "source_tree_sha256", "targets"]
    },
    "security_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "statement", "statement_sha256"],
        "properties": {
          "category": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
          "statement": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}/gate-statement\\.json$"},
          "statement_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
