{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pharma-intelligence.invalid/schemas/mcp-sender-constraint-report.v2.json",
  "title": "MCP sender-constraint production evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "status",
    "environment_kind",
    "environment_id",
    "tested_at",
    "subject",
    "idp_issuer_url",
    "resource_server_url",
    "clients",
    "checks",
    "replay_store",
    "references"
  ],
  "properties": {
    "schema": {"const": "pharma.mcp-sender-constraint-evidence.v2"},
    "schema_version": {"const": 2},
    "status": {"const": "passed"},
    "environment_kind": {"enum": ["preproduction", "production"]},
    "environment_id": {"type": "string", "minLength": 3, "maxLength": 120},
    "tested_at": {"type": "string", "format": "date-time"},
    "subject": {"type": "object", "minProperties": 4},
    "idp_issuer_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "resource_server_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "clients": {
      "type": "array",
      "minItems": 2,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "dpop_supported"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 120},
          "version": {"type": "string", "minLength": 1, "maxLength": 80},
          "dpop_supported": {"const": true}
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "access_token_signature",
        "ath_binding",
        "bearer_rejected",
        "htm_binding",
        "htu_binding",
        "iat_window",
        "jkt_binding",
        "jti_replay_rejected",
        "key_rotation",
        "replay_store_fail_closed",
        "token_revocation"
      ],
      "properties": {
        "access_token_signature": {"const": true},
        "ath_binding": {"const": true},
        "bearer_rejected": {"const": true},
        "htm_binding": {"const": true},
        "htu_binding": {"const": true},
        "iat_window": {"const": true},
        "jkt_binding": {"const": true},
        "jti_replay_rejected": {"const": true},
        "key_rotation": {"const": true},
        "replay_store_fail_closed": {"const": true},
        "token_revocation": {"const": true}
      }
    },
    "replay_store": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failure_mode", "shared", "tls"],
      "properties": {
        "failure_mode": {"const": "fail_closed"},
        "shared": {"const": true},
        "tls": {"const": true}
      }
    },
    "references": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gateway_change", "idp_change", "security_approval"],
      "properties": {
        "gateway_change": {"type": "string", "minLength": 3, "maxLength": 200},
        "idp_change": {"type": "string", "minLength": 3, "maxLength": 200},
        "security_approval": {"type": "string", "minLength": 3, "maxLength": 200}
      }
    }
  }
}
