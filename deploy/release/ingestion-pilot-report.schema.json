{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pharma-intelligence.invalid/schemas/ingestion-pilot-evidence.v2.json",
  "title": "AI-governed real-source pilot ingestion evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "generated_at",
    "status",
    "environment",
    "production_claim",
    "source_id",
    "source_type",
    "dataset_key",
    "license_id",
    "source_files",
    "versions",
    "governance",
    "runs",
    "search",
    "source_content_created_by_test"
  ],
  "properties": {
    "schema": {"const": "pharma.ingestion-pilot-evidence.v2"},
    "schema_version": {"const": 2},
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {"const": "passed"},
    "environment": {"const": "local-wsl"},
    "production_claim": {"const": false},
    "source_id": {"type": "string", "format": "uuid"},
    "source_type": {"enum": ["folder", "http_manifest", "s3_snapshot", "sftp_snapshot", "smb_snapshot"]},
    "dataset_key": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,80}$"},
    "license_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,119}$"},
    "source_files": {"$ref": "#/$defs/sourceInventory"},
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current",
        "traceable",
        "malware_scanned",
        "processed",
        "governable",
        "governed",
        "projected",
        "failed",
        "idempotent_second_scan"
      ],
      "properties": {
        "current": {"type": "integer", "minimum": 1},
        "traceable": {"type": "integer", "minimum": 1},
        "malware_scanned": {"type": "integer", "minimum": 1},
        "processed": {"type": "integer", "minimum": 1},
        "governable": {"type": "integer", "minimum": 1},
        "governed": {"type": "integer", "minimum": 1},
        "projected": {"type": "integer", "minimum": 1},
        "failed": {"const": 0},
        "idempotent_second_scan": {"const": true}
      }
    },
    "governance": {"$ref": "#/$defs/governance"},
    "runs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/run"}
    },
    "search": {"$ref": "#/$defs/search"},
    "source_content_created_by_test": {"const": false}
  },
  "$defs": {
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configured_model",
        "extraction_runs",
        "successful_extraction_runs",
        "failed_extraction_runs",
        "configured_model_runs",
        "input_tokens",
        "output_tokens",
        "segments",
        "accounted_segments",
        "staged_facts",
        "quote_verified_facts"
      ],
      "properties": {
        "configured_model": {"type": "string", "minLength": 1, "maxLength": 160},
        "extraction_runs": {"type": "integer", "minimum": 1},
        "successful_extraction_runs": {"type": "integer", "minimum": 1},
        "failed_extraction_runs": {"const": 0},
        "configured_model_runs": {"type": "integer", "minimum": 1},
        "input_tokens": {"type": "integer", "minimum": 1},
        "output_tokens": {"type": "integer", "minimum": 1},
        "segments": {"type": "integer", "minimum": 1},
        "accounted_segments": {"type": "integer", "minimum": 1},
        "staged_facts": {"type": "integer", "minimum": 1},
        "quote_verified_facts": {"type": "integer", "minimum": 1}
      }
    },
    "sourceInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "source_id",
        "source_type",
        "connector_id",
        "authoritative_inventory",
        "discovered",
        "stable",
        "oversized",
        "excluded",
        "error_count",
        "configuration_error_count"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "source_id": {"type": "string", "format": "uuid"},
        "source_type": {"enum": ["folder", "http_manifest", "s3_snapshot", "sftp_snapshot", "smb_snapshot"]},
        "connector_id": {
          "enum": ["folder-v1", "http-manifest-v1", "s3-snapshot-v1", "sftp-snapshot-v1", "smb-snapshot-v1"]
        },
        "authoritative_inventory": {"type": "boolean"},
        "discovered": {"type": "integer", "minimum": 1},
        "stable": {"type": "integer", "minimum": 1},
        "oversized": {"const": 0},
        "excluded": {"type": "integer", "minimum": 0},
        "error_count": {"const": 0},
        "configuration_error_count": {"const": 0}
      }
    },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discovered", "unchanged", "unstable", "excluded", "failed"],
      "properties": {
        "discovered": {"type": "integer", "minimum": 0},
        "unchanged": {"type": "integer", "minimum": 0},
        "unstable": {"const": 0},
        "excluded": {"type": "integer", "minimum": 0},
        "failed": {"const": 0}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "state", "counters"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "state": {"const": "SUCCEEDED"},
        "counters": {"$ref": "#/$defs/counters"}
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cluster", "deliveries"],
      "properties": {
        "cluster": {
          "type": "object",
          "additionalProperties": false,
          "required": ["aliases", "available", "cluster_name", "cluster_status", "error", "version"],
          "properties": {
            "aliases": {
              "type": "object",
              "additionalProperties": false,
              "required": ["entities", "evidence", "knowledge"],
              "properties": {
                "entities": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string"}},
                "evidence": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string"}},
                "knowledge": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string"}}
              }
            },
            "available": {"const": true},
            "cluster_name": {"const": "pharma-search"},
            "cluster_status": {"const": "green"},
            "error": {"type": "null"},
            "version": {"const": "3.7.0"}
          }
        },
        "deliveries": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dead", "processing", "retry", "succeeded"],
          "properties": {
            "dead": {"const": 0},
            "processing": {"const": 0},
            "retry": {"const": 0},
            "succeeded": {"type": "integer", "minimum": 0}
          }
        }
      }
    }
  }
}
