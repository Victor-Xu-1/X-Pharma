{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/pharma/goal-completion-matrix.v1.schema.json",
  "title": "Pharma intelligence GOAL section 19 completion matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "goal_document_id", "goal_version", "section", "requirements"],
  "properties": {
    "schema": {"const": "pharma.goal-completion-matrix.v1"},
    "schema_version": {"const": 1},
    "goal_document_id": {"const": "PIP-GOAL-001"},
    "goal_version": {"const": "1.9.9"},
    "section": {"const": 19},
    "requirements": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "ordinal", "group", "title", "baseline_categories", "production_categories", "requires_release_security", "requires_signed_git_tag", "requires_bundle_signature"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+\\.[a-z][a-z0-9_]+$"},
          "ordinal": {"type": "integer", "minimum": 1, "maximum": 24},
          "group": {"enum": ["product_data", "human_agent", "security_reliability_operations", "engineering_delivery"]},
          "title": {"type": "string", "minLength": 4, "maxLength": 120},
          "baseline_categories": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"}
          },
          "production_categories": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"}
          },
          "requires_release_security": {"type": "boolean"},
          "requires_signed_git_tag": {"type": "boolean"},
          "requires_bundle_signature": {"type": "boolean"}
        }
      }
    }
  }
}
