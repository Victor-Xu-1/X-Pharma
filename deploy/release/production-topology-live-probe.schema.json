{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/pharma/production-topology-live-probe.v1.schema.json",
  "title": "Live Kubernetes and HTTPS production topology probe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "status",
    "environment_kind",
    "environment_id",
    "tested_at",
    "subject",
    "topology_report_sha256",
    "kube_context_sha256",
    "namespace",
    "namespace_uid",
    "kubernetes",
    "workloads",
    "gateway",
    "network_policy",
    "endpoints",
    "credentials_recorded"
  ],
  "properties": {
    "schema": {"const": "pharma.production-topology-live-probe.v1"},
    "schema_version": {"const": 1},
    "status": {"const": "passed"},
    "environment_kind": {"enum": ["preproduction", "production"]},
    "environment_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"},
    "tested_at": {"type": "string", "format": "date-time"},
    "subject": {"type": "object"},
    "topology_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "kube_context_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "namespace": {"type": "string", "pattern": "^[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?$"},
    "namespace_uid": {"type": "string", "format": "uuid"},
    "kubernetes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["server_version", "ready_schedulable_nodes", "availability_zones", "node_architectures"],
      "properties": {
        "server_version": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"},
        "ready_schedulable_nodes": {"type": "integer", "minimum": 3},
        "availability_zones": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 120}
        },
        "node_architectures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["amd64", "arm64"]}
        }
      }
    },
    "workloads": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/workload"}
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "programmed", "listener_hosts", "route_hosts"],
      "properties": {
        "name": {"const": "pharma-public"},
        "programmed": {"const": true},
        "listener_hosts": {"$ref": "#/$defs/twoHosts"},
        "route_hosts": {"$ref": "#/$defs/twoHosts"}
      }
    },
    "network_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "default_deny_ingress", "default_deny_egress"],
      "properties": {
        "count": {"type": "integer", "minimum": 8},
        "default_deny_ingress": {"const": true},
        "default_deny_egress": {"const": true}
      }
    },
    "endpoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["web", "mcp"],
      "properties": {
        "web": {"$ref": "#/$defs/webEndpoint"},
        "mcp": {"$ref": "#/$defs/mcpEndpoint"}
      }
    },
    "credentials_recorded": {"const": false}
  },
  "$defs": {
    "twoHosts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "format": "hostname"}
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "desired_replicas",
        "ready_replicas",
        "available_replicas",
        "generation",
        "observed_generation",
        "image_digests",
        "pdb_present",
        "hpa_present"
      ],
      "properties": {
        "name": {
            "enum": ["pharma-api", "pharma-jobs", "pharma-parser", "pharma-ocr"]
        },
        "kind": {"const": "Deployment"},
        "desired_replicas": {"type": "integer", "minimum": 2},
        "ready_replicas": {"type": "integer", "minimum": 2},
        "available_replicas": {"type": "integer", "minimum": 2},
        "generation": {"type": "integer", "minimum": 1},
        "observed_generation": {"type": "integer", "minimum": 1},
        "image_digests": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$"}
        },
        "pdb_present": {"const": true},
        "hpa_present": {"type": "boolean"}
      }
    },
    "endpointBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "status_code", "tls_version", "certificate_sha256", "hsts", "unauthenticated_rejected"],
      "properties": {
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "status_code": {"type": "integer", "minimum": 100, "maximum": 599},
        "tls_version": {"enum": ["TLSv1.2", "TLSv1.3"]},
        "certificate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "hsts": {"const": true},
        "unauthenticated_rejected": {"type": ["boolean", "null"]}
      }
    },
    "webEndpoint": {
      "allOf": [
        {"$ref": "#/$defs/endpointBase"},
        {"properties": {"status_code": {"const": 200}, "unauthenticated_rejected": {"const": null}}}
      ]
    },
    "mcpEndpoint": {
      "allOf": [
        {"$ref": "#/$defs/endpointBase"},
        {"properties": {"status_code": {"enum": [401, 403]}, "unauthenticated_rejected": {"const": true}}}
      ]
    }
  }
}
