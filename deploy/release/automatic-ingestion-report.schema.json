{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pharma-intelligence.invalid/schemas/automatic-ingestion-evidence.v4.json",
  "title": "Unattended AI-governed Temporal ingestion evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "generated_at",
    "status",
    "environment",
    "production_claim",
    "source_id",
    "source_type",
    "dataset_key",
    "license_id",
    "trigger",
    "workflow",
    "versions",
    "governance",
    "search"
  ],
  "properties": {
    "schema": {"const": "pharma.automatic-ingestion-evidence.v4"},
    "schema_version": {"const": 4},
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {"const": "passed"},
    "environment": {"const": "local-wsl"},
    "production_claim": {"const": false},
    "source_id": {"type": "string", "format": "uuid"},
    "source_type": {"enum": ["folder", "http_manifest", "s3_snapshot", "sftp_snapshot", "smb_snapshot"]},
    "dataset_key": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,80}$"},
    "license_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,119}$"},
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "outcome",
        "manual_trigger_used",
        "source_schedule_mutated",
        "source_content_created_by_test",
        "scan_interval_seconds",
        "initial_due_in_seconds",
        "observed_elapsed_seconds",
        "baseline_versions",
        "observed_versions",
        "new_versions",
        "baseline_run_id",
        "baseline_run_created_at",
        "observed_run_created_at",
        "policy_sha256",
        "baseline_policy_runs",
        "observed_policy_runs"
      ],
      "properties": {
        "mode": {"const": "temporal-scheduler"},
        "outcome": {"enum": ["new_version", "policy_reprocess", "unchanged"]},
        "manual_trigger_used": {"const": false},
        "source_schedule_mutated": {"const": false},
        "source_content_created_by_test": {"const": false},
        "scan_interval_seconds": {"type": "integer", "minimum": 10, "maximum": 86400},
        "initial_due_in_seconds": {"type": "integer", "minimum": 0, "maximum": 86400},
        "observed_elapsed_seconds": {"type": "integer", "minimum": 0, "maximum": 86400},
        "baseline_versions": {"type": "integer", "minimum": 0},
        "observed_versions": {"type": "integer", "minimum": 1},
        "new_versions": {"type": "integer", "minimum": 0},
        "baseline_run_id": {"type": "string", "format": "uuid"},
        "baseline_run_created_at": {"type": "string", "format": "date-time"},
        "observed_run_created_at": {"type": "string", "format": "date-time"},
        "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "baseline_policy_runs": {"type": "integer", "minimum": 0},
        "observed_policy_runs": {"type": "integer", "minimum": 0}
      },
      "allOf": [
        {
          "if": {"properties": {"outcome": {"const": "new_version"}}},
          "then": {"properties": {"new_versions": {"minimum": 1}}}
        },
        {
          "if": {"properties": {"outcome": {"const": "policy_reprocess"}}},
          "then": {"properties": {"new_versions": {"const": 0}}}
        },
        {
          "if": {"properties": {"outcome": {"const": "unchanged"}}},
          "then": {"properties": {"new_versions": {"const": 0}}}
        }
      ]
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "workflow_id", "state", "counters"],
      "properties": {
        "run_id": {"type": "string", "format": "uuid"},
        "workflow_id": {"type": "string", "minLength": 20, "maxLength": 200},
        "state": {"const": "SUCCEEDED"},
        "counters": {"$ref": "#/$defs/counters"}
      }
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current",
        "traceable",
        "malware_scanned",
        "processed",
        "governable",
        "governed",
        "projected",
        "failed"
      ],
      "properties": {
        "current": {"type": "integer", "minimum": 1},
        "traceable": {"type": "integer", "minimum": 1},
        "malware_scanned": {"type": "integer", "minimum": 1},
        "processed": {"type": "integer", "minimum": 1},
        "governable": {"type": "integer", "minimum": 1},
        "governed": {"type": "integer", "minimum": 1},
        "projected": {"type": "integer", "minimum": 1},
        "failed": {"const": 0}
      }
    },
    "governance": {"$ref": "#/$defs/governance"},
    "search": {"$ref": "#/$defs/search"}
  },
  "$defs": {
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discovered", "unchanged", "unstable", "excluded", "failed"],
      "properties": {
        "discovered": {"type": "integer", "minimum": 0},
        "unchanged": {"type": "integer", "minimum": 0},
        "unstable": {"const": 0},
        "excluded": {"type": "integer", "minimum": 0},
        "failed": {"const": 0}
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configured_model",
        "extraction_runs",
        "successful_extraction_runs",
        "failed_extraction_runs",
        "configured_model_runs",
        "input_tokens",
        "output_tokens",
        "segments",
        "accounted_segments",
        "staged_facts",
        "quote_verified_facts"
      ],
      "properties": {
        "configured_model": {"type": "string", "minLength": 1, "maxLength": 160},
        "extraction_runs": {"type": "integer", "minimum": 1},
        "successful_extraction_runs": {"type": "integer", "minimum": 1},
        "failed_extraction_runs": {"const": 0},
        "configured_model_runs": {"type": "integer", "minimum": 1},
        "input_tokens": {"type": "integer", "minimum": 1},
        "output_tokens": {"type": "integer", "minimum": 1},
        "segments": {"type": "integer", "minimum": 1},
        "accounted_segments": {"type": "integer", "minimum": 1},
        "staged_facts": {"type": "integer", "minimum": 1},
        "quote_verified_facts": {"type": "integer", "minimum": 1}
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cluster", "deliveries"],
      "properties": {
        "cluster": {
          "type": "object",
          "additionalProperties": false,
          "required": ["aliases", "available", "cluster_name", "cluster_status", "error", "version"],
          "properties": {
            "aliases": {
              "type": "object",
              "additionalProperties": false,
              "required": ["entities", "evidence", "knowledge"],
              "properties": {
                "entities": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string"}},
                "evidence": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string"}},
                "knowledge": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string"}}
              }
            },
            "available": {"const": true},
            "cluster_name": {"const": "pharma-search"},
            "cluster_status": {"const": "green"},
            "error": {"type": "null"},
            "version": {"const": "3.7.0"}
          }
        },
        "deliveries": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dead", "processing", "retry", "succeeded"],
          "properties": {
            "dead": {"const": 0},
            "processing": {"const": 0},
            "retry": {"const": 0},
            "succeeded": {"type": "integer", "minimum": 0}
          }
        }
      }
    }
  }
}
