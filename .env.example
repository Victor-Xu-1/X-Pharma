# Application
APP_ENV=development
APP_IMAGE_TAG=latest
APP_HOST=0.0.0.0
APP_PORT=8080
WEB_PORT=18380
MCP_HOST=0.0.0.0
MCP_PORT=18390
LOG_LEVEL=INFO
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_METRIC_EXPORT_INTERVAL_MS=60000
PUBLIC_BASE_URL=http://127.0.0.1:18380
API_DOCS_ENABLED=false

# PostgreSQL. The migration identity owns DDL; the runtime identity is not a
# superuser and cannot bypass row-level security.
POSTGRES_DB=pharma_intel
POSTGRES_USER=pharma_migration
POSTGRES_PASSWORD=replace-with-random-migration-password
POSTGRES_RUNTIME_USER=pharma_runtime
POSTGRES_RUNTIME_PASSWORD=replace-with-random-runtime-password
POSTGRES_CHECKPOINT_TIMEOUT=15min
POSTGRES_MAX_WAL_SIZE=4GB
POSTGRES_CHECKPOINT_COMPLETION_TARGET=0.9
RUNTIME_DATABASE_URL=postgresql+psycopg://pharma_runtime:replace-with-random-runtime-password@postgres:5432/pharma_intel
DATABASE_URL=postgresql+psycopg://pharma_runtime:replace-with-random-runtime-password@postgres:5432/pharma_intel
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=900
REDIS_URL=redis://redis:6379/0

# Independent cryptographic secrets. Generate a different random value for each.
JWT_SECRET=replace-with-64-random-characters
INTERNAL_SERVICE_JWT_SECRET=replace-with-another-64-random-characters
TENANT_CONTEXT_SIGNING_SECRET=replace-with-a-third-64-random-characters
API_KEY_HASH_SALT=replace-with-32-random-characters
INTERNAL_TOKEN_ISSUER=pharma-mcp-gateway
INTERNAL_TOKEN_AUDIENCE=pharma-domain-api
INTERNAL_TOKEN_LIFETIME_SECONDS=300
SESSION_LIFETIME_MINUTES=480

# Human identity. Local accounts are development-only. Production uses direct
# OpenID Connect Authorization Code + PKCE and pre-linked identities by default.
HUMAN_AUTH_MODE=local
# Development opt-in. Independent registrations get viewer access in a new, empty tenant.
HUMAN_SELF_REGISTRATION_ENABLED=true
HUMAN_OIDC_ISSUER_URL=
HUMAN_OIDC_AUTHORIZATION_URL=
HUMAN_OIDC_TOKEN_URL=
HUMAN_OIDC_JWKS_URL=
HUMAN_OIDC_CLIENT_ID=
HUMAN_OIDC_CLIENT_SECRET=
HUMAN_OIDC_REDIRECT_URI=
HUMAN_OIDC_TENANT_CLAIM=tenant_id
HUMAN_OIDC_AUTO_PROVISION=false
HUMAN_OIDC_DEFAULT_ROLE=viewer
HUMAN_OIDC_ROLE_CLAIM=groups
HUMAN_OIDC_ROLE_MAPPING_JSON={}

# MCP authorization. API-key exchange is local-only; production requires OIDC.
MCP_AUTH_ENABLED=true
MCP_TOKEN_VERIFIER_MODE=api_key
MCP_AUTH_ISSUER_URL=http://127.0.0.1:18380
MCP_RESOURCE_SERVER_URL=http://127.0.0.1:18390/mcp
MCP_OIDC_JWKS_URL=
MCP_OIDC_AUDIENCE=pharma-intelligence-mcp
MCP_OIDC_TENANT_CLAIM=tenant_id
MCP_OIDC_CLIENT_ID_CLAIM=azp
MCP_OIDC_JWKS_CACHE_SECONDS=300
MCP_REQUIRE_TOKEN_CONFIRMATION=false
MCP_DPOP_REQUIRED=false
MCP_DPOP_MAX_PROOF_AGE_SECONDS=120
MCP_DPOP_CLOCK_SKEW_SECONDS=30
MCP_DPOP_REPLAY_TIMEOUT_SECONDS=1.0
MCP_REQUIRED_SCOPE=mcp:connect
MCP_COMMERCIAL_ENFORCEMENT_ENABLED=true
MCP_RESERVATION_LEASE_SECONDS=120
MCP_MAX_DURABLE_RESULT_BYTES=2000000
MCP_MAX_BILLABLE_UNITS_PER_CALL=1000000
MCP_MAX_ACTIVE_RESERVATIONS_PER_CLIENT=20
MCP_CURSOR_SIGNING_SECRET=replace-with-an-independent-random-secret-at-least-32-bytes
MCP_CURSOR_TTL_SECONDS=300
MCP_CURSOR_MAX_TOKEN_CHARS=4096
MCP_CORRELATION_HMAC_SECRET=replace-with-a-fifth-independent-random-secret-at-least-32-bytes
MCP_CORRELATION_KEY_ID=local-correlation-v1
MCP_TRUSTED_PROXY_CIDRS=
MCP_TRUSTED_PROXY_HOPS=1
MCP_NETWORK_IPV4_PREFIX_LENGTH=24
MCP_NETWORK_IPV6_PREFIX_LENGTH=56
# Independent HMAC key for immutable billing-period manifests.
BILLING_STATEMENT_SIGNING_SECRET=replace-with-a-sixth-independent-random-secret-at-least-32-bytes
BILLING_STATEMENT_SIGNING_KEY_ID=billing-hmac-v1
# Outbound-only ERP/payment adapter. This switch enables its role inside the unified jobs process.
BILLING_PROVIDER_ENABLED=false
BILLING_PROVIDER_NAME=external-erp
BILLING_PROVIDER_BASE_URL=
BILLING_PROVIDER_API_TOKEN=
BILLING_PROVIDER_VERIFY_CERTS=true
BILLING_PROVIDER_CA_CERTS=
BILLING_PROVIDER_CONNECT_TIMEOUT_SECONDS=5
BILLING_PROVIDER_REQUEST_TIMEOUT_SECONDS=30
BILLING_PROVIDER_MAX_RESPONSE_BYTES=65536
BILLING_PROVIDER_MAX_METADATA_BYTES=16384
BILLING_PROVIDER_POLL_SECONDS=2
BILLING_PROVIDER_BATCH_SIZE=50
BILLING_PROVIDER_LEASE_SECONDS=120
BILLING_PROVIDER_MAX_ATTEMPTS=8
BILLING_PROVIDER_RETRY_BASE_SECONDS=2
BILLING_PROVIDER_RETRY_MAX_SECONDS=300
# Human billing disputes must receive a terminal decision within this window.
BILLING_DISPUTE_SLA_HOURS=120
# Independent HMAC key for governed export manifests.
EXPORT_MANIFEST_SIGNING_SECRET=replace-with-a-seventh-independent-random-secret-at-least-32-bytes
EXPORT_MANIFEST_SIGNING_KEY_ID=export-hmac-v1
EXPORT_RESERVATION_LEASE_SECONDS=7200
EXPORT_READ_PAGE_SIZE_MAX=250
AGENT_API_BASE_URL=http://api:8080

# OpenSearch is a rebuildable projection. Local Compose disables its security
# plugin on a loopback-only port; production requires verified TLS and a
# least-privilege service identity.
SEARCH_BACKEND=opensearch
OPENSEARCH_URL=http://opensearch:9200
# Local Compose uses one unsecured loopback cluster. Production injects separate
# query/projector credentials into API/projector Pods; do not share one account.
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_CA_CERTS=
OPENSEARCH_REQUEST_TIMEOUT_SECONDS=10
OPENSEARCH_MAX_RETRIES=3
OPENSEARCH_POOL_MAXSIZE=50
OPENSEARCH_INDEX_PREFIX=pharma
OPENSEARCH_INDEX_SHARDS=1
OPENSEARCH_INDEX_REPLICAS=0
# Development stays lexical unless a governed third-party OpenAI-compatible
# HTTPS embedding API is configured. Local inference and fallback are prohibited.
SEARCH_SEMANTIC_ENABLED=false
# Only the isolated browser acceptance harness may enable this; production rejects it.
SEARCH_ALLOW_NON_AUTHORITATIVE_PROJECTION=false
SEARCH_EMBEDDING_BASE_URL=
SEARCH_EMBEDDING_API_KEY=
SEARCH_EMBEDDING_MODEL=
SEARCH_EMBEDDING_DIMENSIONS=1024
SEARCH_EMBEDDING_BATCH_SIZE=16
SEARCH_EMBEDDING_MAX_INPUT_CHARS=8192
SEARCH_EMBEDDING_REQUEST_TIMEOUT_SECONDS=30
SEARCH_EMBEDDING_MAX_RETRIES=2
SEARCH_HYBRID_LEXICAL_WEIGHT=0.4
SEARCH_SEMANTIC_MIN_SCORE=0.55
SEARCH_HYBRID_MAX_CANDIDATES=1000
SEARCH_PROJECTION_ENABLED=true
SEARCH_ALLOW_GLOBAL_REBUILD=false
# Exact human user IDs allowed to run global projection operations. Tenant admins are not operators by default.
PLATFORM_OPERATOR_USER_IDS=
DATA_QUALITY_EVALUATION_INTERVAL_SECONDS=900
DATA_QUALITY_WINDOW_HOURS=24
DATA_QUALITY_ISSUE_SLA_HOURS=24
DATA_QUALITY_COMPLETENESS_MIN=0.95
DATA_QUALITY_DUPLICATE_RATE_MAX=0.05
DATA_QUALITY_CITATION_COVERAGE_MIN=0.99
DATA_QUALITY_FRESHNESS_COVERAGE_MIN=0.95
DATA_QUALITY_INGESTION_SUCCESS_MIN=0.95
DATA_QUALITY_DRIFT_MAX=0.10
SEARCH_PROJECTION_POLL_SECONDS=1
SEARCH_PROJECTION_BATCH_SIZE=50
SEARCH_PROJECTION_LEASE_SECONDS=120
SEARCH_PROJECTION_MAX_ATTEMPTS=8
SEARCH_PROJECTION_RETRY_BASE_SECONDS=2
SEARCH_PROJECTION_RETRY_MAX_SECONDS=300
SEARCH_CHUNK_CHARS=2400
SEARCH_CHUNK_OVERLAP_CHARS=240
SEARCH_MAX_SOURCE_TEXT_BYTES=200000000

# Durable automatic ingestion. Mount exactly one approved source root read-only.
# WSL default. For the Windows Y: drive exposed to WSL, use /mnt/y after
# validating the mount and access policy.
KNOWLEDGE_SOURCE_ROOT=./data/sources/empty
SOURCE_ROOTS=/sources/knowledge
# HTTP Manifest suppliers are disabled until both an exact origin and a named
# environment credential are allowlisted. Put the credential value in the
# deployment secret store, never in a data-source record.
SOURCE_CREDENTIAL_ENV_ALLOWLIST=
SOURCE_CREDENTIAL_MAX_BYTES=16384
SOURCE_HTTP_ALLOWED_ORIGINS=
SOURCE_HTTP_ALLOW_INSECURE_LOOPBACK=false
SOURCE_HTTP_CONNECT_TIMEOUT_SECONDS=10
SOURCE_HTTP_READ_TIMEOUT_SECONDS=60
SOURCE_HTTP_MAX_MANIFEST_BYTES=1048576
SOURCE_HTTP_MAX_PAGES=100
SOURCE_RETRY_BASE_SECONDS=60
SOURCE_RETRY_MAX_SECONDS=3600
SOURCE_NCBI_TOOL=pharma_intelligence_platform
# Recommended by NCBI for operational contact; leave empty only for low-volume local evaluation.
SOURCE_NCBI_EMAIL=
# S3 source credentials use an allowlisted env:// reference whose value is a
# compact JSON object with access_key_id, secret_access_key and optional
# session_token. Prefer workload identity in production and enable its standard
# credential chain only in the deployment overlay that binds the workload role.
SOURCE_S3_ALLOWED_BUCKETS=
SOURCE_S3_ENDPOINT_URL=
SOURCE_S3_REGION=us-east-1
SOURCE_S3_ALLOW_INSECURE_LOOPBACK=false
SOURCE_S3_ALLOW_DEFAULT_CREDENTIAL_CHAIN=false
SOURCE_S3_FORCE_PATH_STYLE=false
SOURCE_S3_CONNECT_TIMEOUT_SECONDS=10
SOURCE_S3_READ_TIMEOUT_SECONDS=60
SOURCE_S3_MAX_PAGES=10000
SOURCE_S3_PAGE_SIZE=1000
# SFTP sources require an exact deployment-level origin allowlist and a mounted
# OpenSSH known_hosts file. Credentials are compact JSON referenced by env://;
# private-key authentication is the production default.
SOURCE_SFTP_ALLOWED_ORIGINS=
SOURCE_SFTP_KNOWN_HOSTS_PATH=
SOURCE_SFTP_ALLOW_PASSWORD_AUTH=false
SOURCE_SFTP_CONNECT_TIMEOUT_SECONDS=10
SOURCE_SFTP_READ_TIMEOUT_SECONDS=60
SOURCE_SFTP_MAX_ENTRIES=1000000
SOURCE_SFTP_MAX_DEPTH=64
# SMB2/3 sources use an exact origin allowlist. Credentials are compact JSON
# with username/password and optional domain/auth_protocol, referenced by env://.
# Signing is always required; production also requires protocol encryption.
SOURCE_SMB_ALLOWED_ORIGINS=
SOURCE_SMB_REQUIRE_ENCRYPTION=true
SOURCE_SMB_ALLOW_INSECURE_LOOPBACK=false
SOURCE_SMB_CONNECT_TIMEOUT_SECONDS=10
SOURCE_SMB_MAX_ENTRIES=1000000
SOURCE_SMB_MAX_DEPTH=64
INGEST_SCAN_INTERVAL_SECONDS=60
INGEST_STABLE_SECONDS=30
INGEST_MAX_FILE_BYTES=1073741824
PARSER_MAX_TEXT_CHARS=50000000
# The local Compose fallback is development-only. Production must inject an
# independent 32+ byte value from the deployment secret manager.
PARSER_SERVICE_TOKEN=
PARSER_BACKEND=in_process
PARSER_SERVICE_URL=http://127.0.0.1:8070
PARSER_SERVICE_CONNECT_TIMEOUT_SECONDS=5
PARSER_SERVICE_REQUEST_TIMEOUT_SECONDS=180
PARSER_SERVICE_MAX_FILE_BYTES=268435456
PARSER_SERVICE_VERIFY_CERTS=true
PARSER_SERVICE_CA_CERTS=
PARSER_SERVICE_CLIENT_CERT=
PARSER_SERVICE_CLIENT_KEY=
OCR_BACKEND=disabled
OCR_SERVICE_URL=http://127.0.0.1:8071
OCR_SERVICE_TOKEN=
OCR_SERVICE_CONNECT_TIMEOUT_SECONDS=5
OCR_SERVICE_REQUEST_TIMEOUT_SECONDS=600
OCR_SERVICE_MAX_FILE_BYTES=268435456
OCR_SERVICE_VERIFY_CERTS=true
OCR_SERVICE_CA_CERTS=
OCR_SERVICE_CLIENT_CERT=
OCR_SERVICE_CLIENT_KEY=
OCR_MODEL_ROOT=
OCR_PYPI_INDEX_URL=https://pypi.org/simple
MALWARE_SCAN_ENABLED=true
MALWARE_SCAN_MAX_FILE_BYTES=268435456
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_CONNECT_TIMEOUT_SECONDS=5
CLAMAV_READ_TIMEOUT_SECONDS=180
CLAMAV_STREAM_CHUNK_BYTES=65536
TEMPORAL_ENABLED=true
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=pharma-data-factory
TEMPORAL_WORKER_ENABLED=true
TEMPORAL_SCHEDULER_ENABLED=true
JOBS_SUPERVISOR_POLL_SECONDS=0.5
JOBS_SHUTDOWN_TIMEOUT_SECONDS=60
TEMPORAL_CONNECT_ATTEMPTS=12
TEMPORAL_CONNECT_BACKOFF_SECONDS=1
TEMPORAL_CONNECT_MAX_BACKOFF_SECONDS=15
TEMPORAL_SCHEDULER_POLL_SECONDS=30
TEMPORAL_MAX_CONCURRENT_ACTIVITIES=20
PLATFORM_OPERATIONS_CONTRACT_PATH=deploy/operations/operations-contract.yaml
# Optional read-only mount containing machine-generated backup/restore,
# release-candidate and production-topology evidence reports.
# PLATFORM_EVIDENCE_ROOT=/data/platform-evidence

# Immutable evidence store. Local development uses a Docker volume. Production
# validation requires S3-compatible storage.
OBJECT_STORE_BACKEND=filesystem
OBJECT_STORE_ROOT=/data/object-store
OBJECT_STORE_S3_ENDPOINT_URL=
OBJECT_STORE_S3_REGION=us-east-1
OBJECT_STORE_S3_BUCKET=pharma-intelligence
OBJECT_STORE_S3_ACCESS_KEY_ID=
OBJECT_STORE_S3_SECRET_ACCESS_KEY=

# Governed AI extraction through an approved third-party OpenAI-compatible HTTPS API.
# Localhost, loopback, embedded URL credentials, query strings, and fragments are rejected.
AI_GOVERNANCE_ENABLED=false
# Required before administrators can save provider credentials in the internal workspace.
# Generate once with: openssl rand -base64 32 | tr '+/' '-_' ; keep the same secret on every API/worker replica.
LLM_CREDENTIALS_ENCRYPTION_KEY=
# Configure an approved HTTPS provider before enabling AI governance.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Optional bounded failover providers. Keep secrets in this environment variable, not source files.
# Each entry requires name, base_url, api_key, and model. Provider-specific response_format_mode,
# thinking_mode, include_schema_in_prompt, max_output_tokens_per_segment, request_timeout_seconds,
# and request_attempts overrides are optional. Failover is used only for bounded 408/429/5xx/network failures.
AI_FALLBACK_PROVIDERS_JSON=[]
AI_ALLOWED_RESPONSE_MODELS_JSON=[]
# Provider-specific thinking control; keep provider_default unless the provider documents support.
AI_THINKING_MODE=provider_default
# Compatibility mode for providers that accept JSON Schema but need it repeated in the prompt.
AI_INCLUDE_SCHEMA_IN_PROMPT=false
# json_schema is the default; use prompt_only for providers that abort on response_format while retaining server-side validation.
AI_RESPONSE_FORMAT_MODE=json_schema
AI_REQUEST_TIMEOUT_SECONDS=120
AI_REQUEST_ATTEMPTS=3
AI_RETRY_BASE_BACKOFF_SECONDS=1
AI_RETRY_MAX_BACKOFF_SECONDS=15
AI_STALE_RUN_SECONDS=7200
AI_MAX_INPUT_CHARS=200000
AI_MAX_DOCUMENT_CHARS=5000000
AI_MAX_SEGMENTS_PER_DOCUMENT=32
AI_MAX_FACTS_PER_SEGMENT=100
AI_MAX_MODEL_STRING_CHARS=4000
AI_MAX_MODEL_COLLECTION_ITEMS=100
AI_MAX_OUTPUT_TOKENS_PER_SEGMENT=16384
AI_MAX_DOCUMENT_INPUT_TOKENS=1500000
AI_MAX_DOCUMENT_OUTPUT_TOKENS=262144
AI_MAX_RESPONSE_BYTES=4194304
AI_REQUIRE_USAGE_METADATA=true
AI_REQUIRE_PROVIDER_REQUEST_ID=true
# Production must set the contracted provider rates and a non-zero per-document ceiling.
AI_INPUT_COST_PER_MILLION_TOKENS=0
AI_OUTPUT_COST_PER_MILLION_TOKENS=0
AI_MAX_DOCUMENT_COST=0
AI_AUTO_PUBLISH_THRESHOLD=0.95
AI_AUTO_PUBLISH_FACT_KINDS_JSON=["claim","relationship","target_profile"]

# Deterministic downstream Markdown/Obsidian projection.
MARKDOWN_EXPORT_ROOT=/data/markdown-wiki
